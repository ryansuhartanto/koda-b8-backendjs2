{
	"name": "api",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": [
			"./src/*.ts"
		]
	},
	"scripts": {
		"dev": "vp exec node --env-file=../../.env --watch --watch-path src --watch-preserve-output src/index.ts",
		"preview": "vp exec node --env-file=../../.env src/index.ts"
	},
	"dependencies": {
		"@scalar/express-api-reference": "^0.10.12",
		"bcryptjs": "^3.0.3",
		"cors": "^2.8.6",
		"express": "^5.2.1",
		"jsonwebtoken": "^9.0.3",
		"swagger-jsdoc": "^6.3.0"
	},
	"devDependencies": {
		"@types/bcryptjs": "^3.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/swagger-jsdoc": "^6.0.4"
	}
}
